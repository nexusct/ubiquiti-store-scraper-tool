# Example environment variables for Ubiquiti Store Scraper Tool
# Copy this file to .env and fill in your actual values

# Optional: Custom output directory (overrides config.js if set)
# OUTPUT_DIR=./ubiquiti_store

# Optional: Maximum pages to crawl (overrides config.js if set)
# MAX_PAGES=1000

# Optional: Crawl delay in milliseconds (overrides config.js if set)
# CRAWL_DELAY=500

# Optional: API keys (if integrating with external services)
# GOOGLE_API_KEY=your_api_key_here
# AWS_ACCESS_KEY_ID=your_aws_key_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_here

# Note: The .env file is gitignored and will never be committed to the repository
